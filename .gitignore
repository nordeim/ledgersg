# Environment files — .env.example templates are the canonical dev defaults;
# local .env files may contain real secrets and must never be committed (A-7)
# NOTE: gitignore does not untrack already-committed files — if a .env ever
# reappears in `git ls-files`, `git rm --cached` it (P5/C-1: the P4 commit
# f225547f re-added them via git add -A).
.env
.env.local
.env.*.local
apps/backend/.env
apps/web/.env.local

# Build artifacts & bytecode (P5/H-9 — 211 .pyc + 54 dist files were tracked)
__pycache__/
*.pyc
dist/

# Test/tooling output directories (P11/M-10 — emitted by the current
# configs; `git add -A` history repeatedly swept them in)
coverage/
test-results/
playwright-report/

# Local lockfiles & key material (P11/M-10 + the DEPLOYMENT.md claim):
# the backend venv is built via `uv sync` — the generated lock is a
# local artifact (never committed by repo convention); *.key finally
# honors the claim DEPLOYMENT.md already made.
apps/backend/uv.lock
*.key

# Editor/backup files
*.bak
*.bak2
*.bak3
*.bak4
*.swp
*~

# Runtime/build logs (P16 hygiene — the tracked copies were untracked)
*_log.txt
*_log_new.txt
start_*_log.txt
startup_log.txt

# P17: untracked runtime artifact (was committed by an earlier session)
apps/backend/database_connection_status.txt
