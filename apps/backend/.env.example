# LedgerSG API Environment Variables
#
# Copy to .env for local development:
#   cp apps/backend/.env.example apps/backend/.env
#
# Every variable below is actually read by config/settings/*.py.

# Django
DEBUG=true
SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_SETTINGS_MODULE=config.settings.development

# Database
DB_NAME=ledgersg_dev
DB_USER=ledgersg
DB_PASSWORD=ledgersg_secret_to_change
DB_HOST=localhost
DB_PORT=5432

# Redis (Celery broker/result backend AND the Django cache used by the
# tenant middleware membership cache — a live Redis on :6379 is a hard
# prerequisite for org-scoped requests)
REDIS_URL=redis://localhost:6379/0

# CORS (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate limiting (SEC-002; defaults ON in base settings — testing.py
# forces it off so auth tests do not rate-limit each other)
RATELIMIT_ENABLE=true

# Development conveniences (development settings only)
DEBUG_TOOLBAR=true
CELERY_ALWAYS_EAGER=true

# Sentry (optional)
SENTRY_DSN=

# Admin email
ADMIN_EMAIL=admin@ledgersg.sg
