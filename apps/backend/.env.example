# LedgerSG API Environment Variables
#
# Copy to .env for local development:
#   cp apps/backend/.env.example apps/backend/.env
#
# Every variable read by config/settings/*.py is listed below (verified by
# audit — see docs/REMEDIATION_PLAN_2026-11-21_P3.md, finding D-4).

# Django
DEBUG=true
SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_SETTINGS_MODULE=config.settings.development

# Allowed hosts (comma-separated; the default is localhost,127.0.0.1 —
# production must list the real hostnames behind the proxy)
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (also honoured by config/settings/testing.py — CI passes a
# per-run generated DB_PASSWORD; no credential is committed)
DB_NAME=ledgersg_dev
DB_USER=ledgersg
DB_PASSWORD=ledgersg_secret_to_change
DB_HOST=localhost
DB_PORT=5432

# Redis (Celery broker/result backend AND the Django cache used by the
# tenant middleware membership cache — a live Redis on :6379 is a hard
# prerequisite for org-scoped requests)
REDIS_URL=redis://localhost:6379/0

# CORS (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate limiting (SEC-002; defaults ON in base settings — testing.py
# forces it off so auth tests do not rate-limit each other)
RATELIMIT_ENABLE=true

# Development conveniences (development settings only)
DEBUG_TOOLBAR=true
CELERY_ALWAYS_EAGER=true

# Django admin (P17/BE-L3 gate): mounts /admin/ when true.
# Defaults: development TRUE, production + testing FALSE. Requires the
# §15c framework tables (django_session + django_admin_log — schema
# v1.2.2+; a schema-only host with the knob on 500s on admin login
# without them). Enable only on a private ops network.
ENABLE_ADMIN=true

# Sentry (optional)
SENTRY_DSN=

# Admin email
ADMIN_EMAIL=admin@ledgersg.sg

# Log directory (P11/C-2 — production settings only; the file handler's path
# is derived from it and the LOGGING dict is copy-on-write). Create it on the
# host before the production boot (see docs/DEPLOYMENT.md); the directory
# must exist and be writable by the service user.
LOG_DIR=/var/log/ledgersg
