<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="urn:oasis:names:specification:ubl:schema:xsd:CreditNote-2"
           xmlns="urn:oasis:names:specification:ubl:schema:xsd:CreditNote-2"
           xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2"
           xmlns:cac="urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2"
           elementFormDefault="qualified"
           version="2.1">

    <xs:annotation>
        <xs:documentation>
            UBL 2.1 CreditNote Schema - LedgerSG PINT-SG Compliant
            Validated against OASIS UBL 2.1 and Singapore PINT-SG
            Version: 2.0.0 (2026-11-28)
            P34/BE-P34-H1(c): restructured into the true three-namespace UBL
            shape. The pre-P34 schema carried three defects: the
            targetNamespace was the Invoice-2 copy-paste artefact (the
            generator correctly emits CreditNote-2, so even the dedicated
            validator rejected every credit note at the root), the line
            element was InvoiceLine/InvoicedQuantity instead of the true
            UBL 2.1 CreditNoteLine/CreditedQuantity, and — like the Invoice
            schema — the local-element declarations and missing amount
            attributes meant it could never validate real UBL output at
            all. The basic components now live in
            ubl-CommonBasicComponents-2.xsd and the aggregates in
            ubl-CommonAggregateComponents-2.xsd.
        </xs:documentation>
    </xs:annotation>

    <xs:import namespace="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2"
               schemaLocation="ubl-CommonBasicComponents-2.xsd"/>
    <xs:import namespace="urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2"
               schemaLocation="ubl-CommonAggregateComponents-2.xsd"/>

    <!-- Root element -->
    <xs:element name="CreditNote" type="CreditNoteType"/>

    <xs:complexType name="CreditNoteType">
        <xs:sequence>
            <!-- Document header -->
            <xs:element ref="cbc:UBLVersionID" minOccurs="0"/>
            <xs:element ref="cbc:CustomizationID" minOccurs="1"/>
            <xs:element ref="cbc:ProfileID" minOccurs="1"/>
            <xs:element ref="cbc:ID" minOccurs="1"/>
            <xs:element ref="cbc:IssueDate" minOccurs="1"/>
            <xs:element ref="cbc:DueDate" minOccurs="0"/>
            <xs:element ref="cbc:CreditNoteTypeCode" minOccurs="1"/>
            <!-- P37/BE-P37-L1: the reason note (BT-22) — the guarded
                 emission (at most one; the repo's data model carries a
                 single notes field). -->
            <xs:element ref="cbc:Note" minOccurs="0"/>
            <xs:element ref="cbc:DocumentCurrencyCode" minOccurs="1"/>
            <xs:element ref="cbc:TaxCurrencyCode" minOccurs="0"/>

            <!-- P37/BE-P37-H1: the original-invoice reference (the UBL
                 position — after the cbc header block, before the parties).
                 The service layer enforces related_document_id for every
                 credit note (P14/H-4), so a service-created document always
                 carries it; minOccurs=0 keeps hand-built payloads valid. -->
            <xs:element ref="cac:BillingReference" minOccurs="0"/>

            <!-- Payment means -->
            <xs:element ref="cac:PaymentMeans" minOccurs="0" maxOccurs="unbounded"/>

            <!-- Parties -->
            <xs:element ref="cac:AccountingSupplierParty" minOccurs="1"/>
            <xs:element ref="cac:AccountingCustomerParty" minOccurs="1"/>

            <!-- Payment terms -->
            <xs:element ref="cac:PaymentTerms" minOccurs="0" maxOccurs="unbounded"/>

            <!-- Allowance/Charge -->
            <xs:element ref="cac:AllowanceCharge" minOccurs="0" maxOccurs="unbounded"/>

            <!-- Tax total -->
            <xs:element ref="cac:TaxTotal" minOccurs="1" maxOccurs="unbounded"/>

            <!-- Monetary total -->
            <xs:element ref="cac:LegalMonetaryTotal" minOccurs="1"/>

            <!-- Credit note lines — the UBL 2.1 CreditNoteLine -->
            <xs:element ref="cac:CreditNoteLine" minOccurs="1" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

</xs:schema>
