# LEDGERSG FRONTEND ENVIRONMENT CONFIGURATION
#
# Copy to .env.local for local development:
#   cp apps/web/.env.example apps/web/.env.local
#
# Every variable in the LIVE section below is read by the codebase (verified
# by audit — see docs/REMEDIATION_PLAN_2026-11-21_P2.md, finding B-4; the
# server-side client that read BACKEND_URL was removed in P7/F-13 as dead
# code — the variable moves to the reserved section):
#   NEXT_PUBLIC_API_URL -> next.config.ts, src/middleware.ts, src/lib/api-client.ts
#   NEXT_OUTPUT_MODE    -> next.config.ts

# =============================================================================
# LIVE VARIABLES (read by the code)
# =============================================================================

# Django Backend API URL (browser-facing)
# - Development: http://localhost:8000
# - Docker: http://backend:8000
# - Production: https://api.ledgersg.sg
NEXT_PUBLIC_API_URL=http://localhost:8000

# Next.js output mode (P10/M-12: standalone is the ONLY supported mode —
# the static-export mode was retired; it cannot support API-driven detail
# routes. "export" remains honoured for local experiments only):
# - "standalone": Server mode — the production path (npm run build:server)
# - "export":     Experiments only — NOT a supported deployment (no build
#                 script ships for it; API-driven pages fail to prerender)
NEXT_OUTPUT_MODE=standalone

# =============================================================================
# RESERVED FOR FUTURE FEATURES — NOT READ BY THE CODE YET
#
# These flags were carried over from an earlier template. Nothing imports
# them today; setting them has no effect. Listed here so the intended names
# survive until the features wire them up.
# =============================================================================

# NEXT_PUBLIC_TOKEN_REFRESH_INTERVAL=840000
# BACKEND_URL=http://localhost:8000
#   (P7/F-13: its only reader, the legacy src/lib/server/api-client.ts,
#   was removed as dead code — no server-side fetch path exists today; the
#   name is kept here until an RSC/SSR data path ships)
# NEXT_PUBLIC_ENABLE_PEPPOL=true
# NEXT_PUBLIC_ENABLE_GST_F5=true
# NEXT_PUBLIC_ENABLE_BCRS=true
# NEXT_PUBLIC_PEPPOL_API_URL=https://api.peppol.sg
# NEXT_PUBLIC_IRAS_API_URL=https://api.iras.gov.sg
# NEXT_PUBLIC_ENABLE_REACT_QUERY_DEVTOOLS=true
# NEXT_PUBLIC_LOG_LEVEL=debug
