# LEDGERSG FRONTEND ENVIRONMENT CONFIGURATION
#
# Copy to .env.local for local development:
#   cp apps/web/.env.example apps/web/.env.local
#
# Every variable below is actually read by the codebase:
#   NEXT_PUBLIC_API_URL, NEXT_OUTPUT_MODE -> next.config.ts, src/lib/api-client.ts
#   Feature flags / devtools / log level   -> src/providers/, src/lib/

# =============================================================================
# BACKEND API CONFIGURATION
# =============================================================================

# Django Backend API URL
# - Development: http://localhost:8000
# - Docker: http://backend:8000
# - Production: https://api.ledgersg.sg
NEXT_PUBLIC_API_URL=http://localhost:8000

# =============================================================================
# NEXT.JS OUTPUT MODE
# =============================================================================

# Output mode selection:
# - "export": Static HTML export - for CDN deployment (npm run build)
# - "standalone": Server mode - for backend integration (npm run build:server)
NEXT_OUTPUT_MODE=standalone

# =============================================================================
# AUTHENTICATION
# =============================================================================

# Silent-refresh lead time before the 15-minute access token expires (ms).
# Backend issues 15-min access + 7-day refresh (HttpOnly cookie).
NEXT_PUBLIC_TOKEN_REFRESH_INTERVAL=840000

# =============================================================================
# FEATURE FLAGS
# =============================================================================

NEXT_PUBLIC_ENABLE_PEPPOL=true
NEXT_PUBLIC_ENABLE_GST_F5=true
NEXT_PUBLIC_ENABLE_BCRS=true

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================

NEXT_PUBLIC_PEPPOL_API_URL=https://api.peppol.sg
NEXT_PUBLIC_IRAS_API_URL=https://api.iras.gov.sg

# =============================================================================
# DEBUGGING
# =============================================================================

NEXT_PUBLIC_ENABLE_REACT_QUERY_DEVTOOLS=true
NEXT_PUBLIC_LOG_LEVEL=debug
